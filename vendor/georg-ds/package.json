{
  "name": "@shipibo-studio/georg-ds",
  "version": "0.6.0",
  "description": "georg design system: tokens, typography, theme, accents and interaction patterns",
  "license": "MIT",
  "author": "Jorge Epuñan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipibo-studio/georg-ds.git"
  },
  "engines": {
    "node": ">=24"
  },
  "style": "./src/georg.css",
  "files": [
