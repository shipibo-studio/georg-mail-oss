    "./components.css": "./src/components.css",
    "./tailwind.css": "./src/tailwind.css",
    "./fonts.css": "./src/fonts.css",
    "./georg-theme.js": "./src/georg-theme.js",
    "./georg-tooltip.js": "./src/georg-tooltip.js",
    "./georg-tabs.js": "./src/georg-tabs.js",
    "./georg-toast.js": "./src/georg-toast.js",
    "./georg-copy.js": "./src/georg-copy.js",
    "./georg-file.js": "./src/georg-file.js",
    "./tokens.json": "./src/tokens.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./src/georg-theme.js",
    "./src/georg-tooltip.js",
    "./src/georg-tabs.js",
    "./src/georg-toast.js",
    "./src/georg-copy.js",
    "./src/georg-file.js"
